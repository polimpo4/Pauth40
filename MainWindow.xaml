<Window x:Class="Pauth40.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Pauth40.Controls"
        Title="Pauth40 - Two Factor Authenticator"
        Icon="Assets/app.ico"
        Width="1120" Height="1008"
        MinWidth="780" MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#020B16"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="MascotGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.28" To="0.62"
                                     Duration="0:0:3.6">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="RootGrid" ClipToBounds="True" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- ================================================================ BACKGROUND -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Ellipse Width="820" Height="640" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-300,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2A00B7FF" Offset="0" />
                        <GradientStop Color="#12007BFF" Offset="0.55" />
                        <GradientStop Color="#00007BFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="780" Height="980" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-320,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#160050C8" Offset="0" />
                        <GradientStop Color="#000050C8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="620" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-240,0,0,-180">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1400A8FF" Offset="0" />
                        <GradientStop Color="#0000A8FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Viewbox Stretch="Fill">
                <Canvas Width="1254" Height="1254">
                    <Path Data="M 0,196 H 58 V 286 H 126 V 432 H 34"
                          Stroke="#3A00D9FF" StrokeThickness="1.3" />
                    <Path Data="M 0,196 H 58 V 286 H 126 V 432 H 34"
                          Stroke="#1200D9FF" StrokeThickness="4.5" />
                    <Path Data="M 0,690 H 44 V 776 H 112 V 902 H 28"
                          Stroke="#2E007BFF" StrokeThickness="1.2" />
                    <Path Data="M 0,1010 H 70 V 1100 H 148 V 1218"
                          Stroke="#2200A8FF" StrokeThickness="1.1" />
                    <Path Data="M 1254,1046 H 1140 L 1044,1142 V 1254"
                          Stroke="#3400D9FF" StrokeThickness="1.3" />
                    <Path Data="M 1254,1160 H 1190 L 1112,1238"
                          Stroke="#20007BFF" StrokeThickness="1.2" />

                    <Ellipse Canvas.Left="55" Canvas.Top="283" Width="7" Height="7"
                             Stroke="#6600D9FF" StrokeThickness="1.2" />
                    <Ellipse Canvas.Left="123" Canvas.Top="429" Width="6" Height="6"
                             Stroke="#4A00A8FF" StrokeThickness="1.1" />
                    <Ellipse Canvas.Left="109" Canvas.Top="899" Width="7" Height="7"
                             Stroke="#44007BFF" StrokeThickness="1.1" />
                    <Ellipse Canvas.Left="1041" Canvas.Top="1139" Width="7" Height="7"
                             Stroke="#5500D9FF" StrokeThickness="1.2" />

                    <Path Data="M 0,142 L 142,0" Stroke="#6A00D9FF" StrokeThickness="1.4" />
                    <Path Data="M 0,96 L 96,0" Stroke="#3600A8FF" StrokeThickness="1.1" />
                    <Path Data="M 0,196 L 196,0" Stroke="#22007BFF" StrokeThickness="1" />
                    <Path Data="M 1254,1104 L 1104,1254" Stroke="#6A00D9FF" StrokeThickness="1.4" />
                    <Path Data="M 1254,1160 L 1160,1254" Stroke="#3600A8FF" StrokeThickness="1.1" />
                    <Path Data="M 1254,1050 L 1050,1254" Stroke="#22007BFF" StrokeThickness="1" />
                </Canvas>
            </Viewbox>

            <Image Source="Assets/duck_silhouette.png"
                   Width="820" Height="820"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,40,-230,0"
                   Stretch="Uniform"
                   Opacity="0.09"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Rectangle Height="1" VerticalAlignment="Top" Margin="0,59,0,0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0000D9FF" Offset="0" />
                        <GradientStop Color="#5500D9FF" Offset="0.5" />
                        <GradientStop Color="#0000D9FF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ================================================================ TITLE BAR -->
        <Grid Grid.Row="0" x:Name="TitleBar"
              Background="#06111F"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border VerticalAlignment="Bottom" Height="1" Background="#1B4164" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="28" Height="28" CornerRadius="7">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/app_mark.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock Text="Pauth40 - Two Factor Authenticator"
                           Style="{StaticResource WindowTitleText}"
                           FontSize="17"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource TitleBarButton}" ToolTip="Settings"
                        Click="Settings_Click" AutomationProperties.Name="Settings">
                    <Path Data="{StaticResource IconSettings}"
                          Style="{StaticResource LineIcon}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.6"
                          Width="18" Height="18" />
                </Button>

                <Button Style="{StaticResource TitleBarButton}" ToolTip="Minimize"
                        Click="Minimize_Click" AutomationProperties.Name="Minimize">
                    <Rectangle Width="11" Height="1.5" RadiusX="0.75" RadiusY="0.75" Fill="{StaticResource TextSecondaryBrush}" />
                </Button>

                <Button Style="{StaticResource TitleBarButton}" ToolTip="Maximize"
                        Click="MaximizeRestore_Click" AutomationProperties.Name="Maximize or restore">
                    <Grid Width="13" Height="13">
                        <Path x:Name="MaximizeIcon" Data="M 1.5,1.5 H 11.5 V 11.5 H 1.5 Z"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" Stretch="Uniform" />
                        <Path x:Name="RestoreIcon" Data="M 4,1.5 H 11.5 V 9 M 1.5,4 H 9 V 11.5 H 1.5 Z"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" Stretch="Uniform" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button Style="{StaticResource CloseTitleBarButton}" ToolTip="Close"
                        Click="Close_Click" AutomationProperties.Name="Close">
                    <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="14" Height="14" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================================ CONTENT -->
        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="16,4">
            <StackPanel Width="860">

                <!-- Mascot -->
                <Grid Height="232" Width="268" HorizontalAlignment="Center">
                    <Ellipse x:Name="MascotGlow" Width="252" Height="252" Opacity="0.4">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#7000D9FF" Offset="0" />
                                <GradientStop Color="#2400D9FF" Offset="0.6" />
                                <GradientStop Color="#0000D9FF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Border Width="232" Height="232" CornerRadius="27"
                            BorderThickness="1.5" BorderBrush="#C600D9FF"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D9FF" BlurRadius="34" ShadowDepth="0" Opacity="0.42" />
                        </Border.Effect>
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/duck.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <Border Width="232" Height="232" CornerRadius="27"
                            BorderThickness="1" BorderBrush="#4D8FE9FF"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False" />
                </Grid>

                <!-- Current code heading -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Path Data="{StaticResource IconShield}"
                          Style="{StaticResource LineIcon}"
                          Stroke="{StaticResource CyanBrush}"
                          StrokeThickness="1.7"
                          Width="26" Height="26" />
                    <TextBlock Text="Current Code:"
                               Style="{StaticResource SectionHeading}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <!-- Code panel -->
                <Border Width="654" Height="146"
                        Margin="0,12,0,0"
                        CornerRadius="22"
                        BorderThickness="1"
                        BorderBrush="#A600D9FF"
                        Background="{StaticResource CodePanelBrush}"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#007BFF" BlurRadius="38" ShadowDepth="0" Opacity="0.36" />
                    </Border.Effect>
                    <Grid ClipToBounds="True">
                        <Border CornerRadius="21" Margin="1" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2600D9FF" Offset="0" />
                                    <GradientStop Color="#0000D9FF" Offset="0.45" />
                                    <GradientStop Color="#14007BFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <controls:CircularCountdown Width="460" Height="460"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fraction="{Binding Fraction}"
                                                    IsActive="{Binding HasSelectedAccount}"
                                                    TrackBrush="#102B42"
                                                    IsHitTestVisible="False" />

                        <TextBlock Text="{Binding CurrentCode}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="68"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,-2,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00D9FF" BlurRadius="16" ShadowDepth="0" Opacity="0.2" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <Border Height="1" VerticalAlignment="Top" Margin="26,0,26,0" Background="#4600D9FF" />
                    </Grid>
                </Border>

                <!-- Next code heading -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Path Data="{StaticResource IconRefresh}"
                          Style="{StaticResource LineIcon}"
                          Stroke="{StaticResource CyanBrush}"
                          StrokeThickness="1.7"
                          Width="20" Height="20" />
                    <TextBlock Text="Next Code In:"
                               Style="{StaticResource SubHeading}"
                               FontSize="25"
                               VerticalAlignment="Center"
                               Margin="9,0,0,0" />
                </StackPanel>

                <!-- Countdown panel -->
                <Border Width="370" Height="66"
                        Margin="0,10,0,0"
                        CornerRadius="17"
                        BorderThickness="1"
                        BorderBrush="#7A007BFF"
                        Background="{StaticResource PanelSoftBrush}"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#007BFF" BlurRadius="26" ShadowDepth="0" Opacity="0.28" />
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="{Binding RemainingSeconds}"
                                   Style="{StaticResource MonoValue}"
                                   FontSize="42"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-6,0,0" />
                        <ProgressBar Style="{StaticResource CountdownProgress}"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     Height="4"
                                     VerticalAlignment="Bottom"
                                     Margin="18,0,18,7"
                                     IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- Account selector -->
                <ComboBox Width="860" Height="66"
                          Margin="0,20,0,0"
                          Style="{StaticResource AccountComboBox}"
                          ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}" />

                <!-- Capture screen -->
                <Button Width="860" Height="62"
                        Margin="0,24,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CaptureCommand}"
                        ToolTip="Capture a QR code from the screen">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconCamera}"
                              Style="{StaticResource LineIcon}"
                              Stroke="#F7FDFF"
                              StrokeThickness="1.7"
                              Width="23" Height="23" />
                        <TextBlock Text="Capture Screen"
                                   Style="{StaticResource ButtonLabel}"
                                   FontSize="20"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Copy code -->
                <Button Width="860" Height="58"
                        Margin="0,12,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopyCommand}"
                        ToolTip="Copy the current authentication code">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Path Data="{StaticResource IconCopy}"
                                  Style="{StaticResource LineIcon}"
                                  Stroke="{StaticResource CyanBrush}"
                                  StrokeThickness="1.6"
                                  Width="19" Height="19"
                                  Visibility="{Binding IsCopyFeedback, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Path Data="{StaticResource IconCheck}"
                                  Style="{StaticResource LineIcon}"
                                  Stroke="{StaticResource CyanBrush}"
                                  StrokeThickness="2"
                                  Width="20" Height="20"
                                  Visibility="{Binding IsCopyFeedback, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Text="{Binding CopyButtonText}"
                                   Style="{StaticResource ButtonLabel}"
                                   FontSize="19"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Viewbox>

        <!-- ================================================================ FOOTER -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="150" Height="1" Background="{StaticResource FooterLineBrush}" />
                <TextBlock Text="Created by Pat&#227;o"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="15.5"
                           FontWeight="SemiBold"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center" />
                <Ellipse Width="21" Height="21" Margin="7,0,5,0">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="Assets/app_mark.png" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="+ brabo"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="15.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Width="150" Height="1" Margin="14,0,0,0" Background="{StaticResource FooterLineBrush}" />
            </StackPanel>
        </Grid>

        <!-- ================================================================ WINDOW FRAME -->
        <Border x:Name="WindowBorder"
                Grid.RowSpan="3"
                CornerRadius="12"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5500D9FF" Offset="0" />
                    <GradientStop Color="#26007BFF" Offset="0.45" />
                    <GradientStop Color="#4D0050C8" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <!-- ================================================================ TOAST -->
        <Border x:Name="ToastHost"
                Grid.RowSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,84"
                Padding="18,10"
                CornerRadius="14"
                Background="#F2071A2D"
                BorderBrush="#9900D9FF"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000814" BlurRadius="28" ShadowDepth="8" Opacity="0.6" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconCheck}"
                      Style="{StaticResource LineIcon}"
                      Stroke="{StaticResource CyanBrush}"
                      StrokeThickness="2"
                      Width="18" Height="18"
                      VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText"
                           Text=""
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
