<UserControl x:Class="Pauth40.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pauth40.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,16,24,30">
        <Grid MaxWidth="760" HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock loc:Loc.Key="settings_heading"
                           Style="{StaticResource SectionHeading}"
                           FontSize="24"
                           Margin="0,0,0,4" />

                <!-- ==================================================== ACCOUNT -->
                <TextBlock loc:Loc.Key="settings_account_heading"
                           Style="{StaticResource SectionHeading}"
                           FontSize="19"
                           Margin="0,14,0,0" />

                <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock loc:Loc.Key="settings_account_email" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="AccountEmailText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Height="1" Background="#1B4164" Margin="0,15,0,15" />

                        <TextBlock loc:Loc.Key="settings_change_password_heading"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{StaticResource CyanBrush}"
                                   Margin="0,0,0,12" />

                        <TextBlock loc:Loc.Key="common_current_password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128" />

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock loc:Loc.Key="common_new_password" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="NewPasswordBox"
                                             Style="{StaticResource FieldPasswordBox}"
                                             MaxLength="128" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock loc:Loc.Key="common_confirm_new_password" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Style="{StaticResource FieldPasswordBox}"
                                             MaxLength="128" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="44"
                                    MinWidth="190"
                                    Padding="20,0"
                                    Click="ChangePassword_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconKey}"
                                          Stroke="{StaticResource CyanBrush}"
                                          Width="17" Height="17" />
                                    <TextBlock loc:Loc.Key="settings_change_password_button"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="14"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="PasswordStatusText"
                                       Grid.Column="1"
                                       Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Margin="14,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== E-MAIL -->
                <TextBlock loc:Loc.Key="settings_email_heading"
                           Style="{StaticResource SectionHeading}"
                           FontSize="19"
                           Margin="0,24,0,0" />

                <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock loc:Loc.Key="settings_email_note"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock loc:Loc.Key="common_smtp_server" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SmtpHostBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock loc:Loc.Key="common_port" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SmtpPortBox" Style="{StaticResource FieldTextBox}" Text="587" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock loc:Loc.Key="common_smtp_user" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SmtpUserBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock loc:Loc.Key="common_smtp_from" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SmtpFromBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock loc:Loc.Key="common_app_password"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="2,13,0,6" />
                        <PasswordBox x:Name="SmtpPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128" />

                        <CheckBox x:Name="SmtpSslCheckBox"
                                  Style="{StaticResource FieldCheckBox}"
                                  loc:Loc.Key="common_use_ssl_recommended"
                                  IsChecked="True"
                                  Margin="0,13,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="44"
                                    Padding="20,0"
                                    Click="SaveSmtp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconCheck}"
                                          Stroke="{StaticResource CyanBrush}"
                                          StrokeThickness="2"
                                          Width="17" Height="17" />
                                    <TextBlock loc:Loc.Key="settings_email_save"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="14"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="TestSmtpButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="44"
                                    Padding="20,0"
                                    Margin="10,0,0,0"
                                    Click="TestSmtp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconMail}"
                                          Stroke="{StaticResource CyanBrush}"
                                          Width="17" Height="17" />
                                    <TextBlock loc:Loc.Key="settings_email_test"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="14"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="SmtpStatusText"
                                       Grid.Column="2"
                                       Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Margin="14,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== DATABASE -->
                <TextBlock loc:Loc.Key="settings_database_heading"
                           Style="{StaticResource SectionHeading}"
                           FontSize="19"
                           Margin="0,24,0,0" />

                <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock loc:Loc.Key="settings_database_note"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,14" />

                        <TextBlock loc:Loc.Key="settings_backup_password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="BackupPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128" />

                        <TextBlock loc:Loc.Key="settings_backup_note"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,8,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="46"
                                    Margin="0,0,6,0"
                                    Click="Export_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource IconExport}"
                                          Stroke="{StaticResource CyanBrush}"
                                          Width="18" Height="18" />
                                    <TextBlock loc:Loc.Key="common_export"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="15"
                                               Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="46"
                                    Margin="6,0,0,0"
                                    Click="Import_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource IconImport}"
                                          Stroke="{StaticResource CyanBrush}"
                                          Width="18" Height="18" />
                                    <TextBlock loc:Loc.Key="common_import"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="15"
                                               Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="BackupStatusText"
                                   Style="{StaticResource StatusText}"
                                   Visibility="Collapsed"
                                   Margin="2,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== LANGUAGE -->
                <TextBlock loc:Loc.Key="settings_language_heading"
                           Style="{StaticResource SectionHeading}"
                           FontSize="19"
                           Margin="0,24,0,0" />

                <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock loc:Loc.Key="settings_language_note"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,14" />

                        <ComboBox x:Name="LanguageCombo"
                                  Width="260"
                                  Height="38"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource LanguageComboBox}"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
