<UserControl x:Class="Pauth40.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pauth40.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,18,26,30">
        <Grid MaxWidth="560" HorizontalAlignment="Center">
            <StackPanel>

                <!-- ==================================================== HEADER -->
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="ModeTitleText"
                               Style="{StaticResource SectionHeading}"
                               FontSize="26"
                               VerticalAlignment="Center" />

                    <ComboBox x:Name="LanguageCombo"
                              Width="190"
                              Height="36"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Style="{StaticResource LanguageComboBox}"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="LanguageCombo_SelectionChanged"
                              loc:Loc.ToolTipKey="common_language" />
                </Grid>

                <!-- ==================================================== SETUP -->
                <StackPanel x:Name="SetupPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock loc:Loc.Key="security_setup_heading"
                               Style="{StaticResource SectionHeading}"
                               FontSize="24" />
                    <TextBlock loc:Loc.Key="security_setup_subtitle"
                               Style="{StaticResource BodyText}"
                               Margin="0,8,0,22" />

                    <TextBlock loc:Loc.Key="common_email" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SetupEmailBox"
                             Style="{StaticResource FieldTextBox}"
                             MaxLength="254"
                             LostFocus="SetupEmail_LostFocus" />

                    <TextBlock loc:Loc.Key="common_password"
                               Style="{StaticResource FieldLabel}"
                               Margin="2,15,0,6" />
                    <PasswordBox x:Name="SetupPasswordBox"
                                 Style="{StaticResource FieldPasswordBox}"
                                 MaxLength="128" />

                    <TextBlock loc:Loc.Key="common_confirm_password"
                               Style="{StaticResource FieldLabel}"
                               Margin="2,15,0,6" />
                    <PasswordBox x:Name="SetupConfirmBox"
                                 Style="{StaticResource FieldPasswordBox}"
                                 MaxLength="128" />

                    <CheckBox x:Name="SetupSmtpCheckBox"
                              Style="{StaticResource FieldCheckBox}"
                              loc:Loc.Key="security_setup_smtp_check"
                              Margin="0,18,0,0"
                              Checked="SetupSmtp_Checked"
                              Unchecked="SetupSmtp_Unchecked" />

                    <StackPanel x:Name="SetupSmtpPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock loc:Loc.Key="common_smtp_server" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SetupSmtpHostBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock loc:Loc.Key="common_port" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SetupSmtpPortBox" Style="{StaticResource FieldTextBox}" Text="587" />
                            </StackPanel>
                        </Grid>

                        <TextBlock loc:Loc.Key="common_smtp_user"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="2,13,0,6" />
                        <TextBox x:Name="SetupSmtpUserBox" Style="{StaticResource FieldTextBox}" />

                        <TextBlock loc:Loc.Key="common_app_password"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="2,13,0,6" />
                        <PasswordBox x:Name="SetupSmtpPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128" />

                        <CheckBox x:Name="SetupSmtpSslCheckBox"
                                  Style="{StaticResource FieldCheckBox}"
                                  loc:Loc.Key="common_use_ssl_recommended"
                                  IsChecked="True"
                                  Margin="0,13,0,0" />

                        <TextBlock loc:Loc.Key="security_setup_smtp_note"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,9,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="SetupErrorText"
                               Style="{StaticResource DangerText}"
                               Visibility="Collapsed"
                               Margin="2,14,0,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="50"
                            Margin="0,20,0,0"
                            Click="Setup_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Style="{StaticResource IconLock}"
                                  Stroke="#F7FDFF"
                                  Width="19" Height="19" />
                            <TextBlock loc:Loc.Key="security_setup_create"
                                       Style="{StaticResource ButtonLabel}"
                                       FontSize="16"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ==================================================== UNLOCK -->
                <StackPanel x:Name="UnlockPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock loc:Loc.Key="security_unlock_heading"
                               Style="{StaticResource SectionHeading}"
                               FontSize="24" />
                    <TextBlock loc:Loc.Key="security_unlock_subtitle"
                               Style="{StaticResource BodyText}"
                               Margin="0,8,0,20" />

                    <Border Style="{StaticResource SectionCard}" Padding="16,13" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock loc:Loc.Key="security_unlock_email_label"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="2,0,0,5" />
                            <TextBlock x:Name="UnlockEmailText"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <TextBlock loc:Loc.Key="common_password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="UnlockPasswordBox"
                                 Style="{StaticResource FieldPasswordBox}"
                                 MaxLength="128"
                                 KeyDown="UnlockPassword_KeyDown" />

                    <TextBlock x:Name="UnlockErrorText"
                               Style="{StaticResource DangerText}"
                               Visibility="Collapsed"
                               Margin="2,14,0,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="50"
                            Margin="0,18,0,0"
                            Click="Unlock_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Style="{StaticResource IconLock}"
                                  Stroke="#F7FDFF"
                                  Width="19" Height="19" />
                            <TextBlock loc:Loc.Key="security_unlock_button"
                                       Style="{StaticResource ButtonLabel}"
                                       FontSize="16"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource LinkButton}"
                            loc:Loc.Key="security_unlock_forgot"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Click="Forgot_Click" />
                </StackPanel>

                <!-- ==================================================== RESET -->
                <StackPanel x:Name="ResetPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock loc:Loc.Key="security_reset_heading"
                               Style="{StaticResource SectionHeading}"
                               FontSize="24" />
                    <TextBlock x:Name="ResetSubtitleText"
                               Style="{StaticResource BodyText}"
                               Margin="0,8,0,16" />

                    <StackPanel x:Name="ResetEmailArea">
                        <Button x:Name="SendCodeButton"
                                Style="{StaticResource SecondaryButton}"
                                Height="48"
                                Click="SendCode_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconMail}"
                                      Stroke="{StaticResource CyanBrush}"
                                      Width="18" Height="18" />
                                <TextBlock loc:Loc.Key="security_reset_send_code"
                                           Style="{StaticResource ButtonLabel}"
                                           FontSize="15"
                                           Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="ResetStatusText"
                                   Style="{StaticResource StatusText}"
                                   Visibility="Collapsed"
                                   Margin="2,10,0,0" />

                        <StackPanel x:Name="ResetSmtpPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <Border Style="{StaticResource SectionCard}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock loc:Loc.Key="security_reset_email_config"
                                               Style="{StaticResource FieldLabel}"
                                               Foreground="{StaticResource CyanBrush}"
                                               Margin="0,0,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock loc:Loc.Key="common_smtp_server" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ResetSmtpHostBox" Style="{StaticResource FieldTextBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock loc:Loc.Key="common_port" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ResetSmtpPortBox" Style="{StaticResource FieldTextBox}" Text="587" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock loc:Loc.Key="common_smtp_user"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="2,12,0,6" />
                                    <TextBox x:Name="ResetSmtpUserBox" Style="{StaticResource FieldTextBox}" />

                                    <TextBlock loc:Loc.Key="common_app_password"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="2,12,0,6" />
                                    <PasswordBox x:Name="ResetSmtpPasswordBox"
                                                 Style="{StaticResource FieldPasswordBox}"
                                                 MaxLength="128" />

                                    <CheckBox x:Name="ResetSmtpSslCheckBox"
                                              Style="{StaticResource FieldCheckBox}"
                                              loc:Loc.Key="common_use_ssl"
                                              IsChecked="True"
                                              Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock loc:Loc.Key="security_reset_code_label"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="2,18,0,6" />
                        <TextBox x:Name="ResetCodeBox"
                                 Style="{StaticResource FieldTextBox}"
                                 MaxLength="6"
                                 FontFamily="Consolas"
                                 FontSize="18" />
                    </StackPanel>

                    <StackPanel x:Name="ResetPasswordArea">
                        <TextBlock loc:Loc.Key="common_new_password"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="2,16,0,6" />
                        <PasswordBox x:Name="ResetPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128" />

                        <TextBlock loc:Loc.Key="common_confirm_new_password"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="2,14,0,6" />
                        <PasswordBox x:Name="ResetConfirmBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128" />
                    </StackPanel>

                    <TextBlock x:Name="LocalNoteText"
                               Style="{StaticResource MutedText}"
                               Visibility="Collapsed"
                               Margin="0,14,0,0" />

                    <TextBlock x:Name="ResetErrorText"
                               Style="{StaticResource DangerText}"
                               Visibility="Collapsed"
                               Margin="2,14,0,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="50"
                            Margin="0,18,0,0"
                            Click="Reset_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Style="{StaticResource IconKey}"
                                  Stroke="#F7FDFF"
                                  Width="19" Height="19" />
                            <TextBlock loc:Loc.Key="security_reset_button"
                                       Style="{StaticResource ButtonLabel}"
                                       FontSize="16"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>

                    <StackPanel Margin="0,12,0,0">
                        <Button x:Name="LocalResetLink"
                                Style="{StaticResource LinkButton}"
                                loc:Loc.Key="security_reset_local_link"
                                HorizontalAlignment="Center"
                                Click="UseLocalRecovery_Click" />
                        <Button Style="{StaticResource LinkButton}"
                                loc:Loc.Key="security_reset_back"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"
                                Click="BackToUnlock_Click" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
