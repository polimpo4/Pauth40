<UserControl x:Class="Pauth40.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pauth40.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,18,26,30">
        <Grid MaxWidth="720" HorizontalAlignment="Center">
            <StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconRefresh}"
                          Stroke="{StaticResource CyanBrush}"
                          StrokeThickness="1.8"
                          Width="25" Height="25"
                          VerticalAlignment="Center" />
                    <TextBlock loc:Loc.Key="update_heading"
                               Style="{StaticResource SectionHeading}"
                               FontSize="25"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock loc:Loc.Key="update_message"
                           Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,18" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SectionCard}" Padding="16,13" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock loc:Loc.Key="update_current_label"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="2,0,0,5" />
                            <TextBlock x:Name="CurrentVersionText"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Consolas"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SectionCard}" Padding="16,13" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock loc:Loc.Key="update_latest_label"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="2,0,0,5" />
                            <TextBlock x:Name="LatestVersionText"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontFamily="Consolas"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock loc:Loc.Key="update_notes_label"
                           Style="{StaticResource FieldLabel}"
                           Margin="2,18,0,6" />

                <Border Style="{StaticResource SectionCard}" Padding="14,12">
                    <ScrollViewer Height="140"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ReleaseNotesText"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource CyanBrush}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Margin="2,14,0,0" />

                <ProgressBar x:Name="DownloadProgress"
                             Style="{StaticResource CountdownProgress}"
                             Height="6"
                             Margin="0,10,0,0"
                             Visibility="Collapsed" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="UpdateButton"
                            Style="{StaticResource PrimaryButton}"
                            Height="48"
                            MinWidth="200"
                            Click="Update_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Style="{StaticResource IconRefresh}"
                                  Stroke="#F7FDFF"
                                  StrokeThickness="1.8"
                                  Width="19" Height="19" />
                            <TextBlock x:Name="UpdateButtonText"
                                       loc:Loc.Key="update_now"
                                       Style="{StaticResource ButtonLabel}"
                                       FontSize="17"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExitButton"
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Height="48"
                            MinWidth="110"
                            Margin="12,0,0,0"
                            Click="Exit_Click">
                        <TextBlock loc:Loc.Key="update_exit"
                                   Style="{StaticResource ButtonLabel}"
                                   FontSize="15" />
                    </Button>

                    <TextBlock x:Name="VersionText"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11.5" />
                </Grid>

                <Button x:Name="ReleaseLink"
                        Style="{StaticResource LinkButton}"
                        loc:Loc.Key="update_open_release"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Visibility="Collapsed"
                        Click="OpenRelease_Click" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
