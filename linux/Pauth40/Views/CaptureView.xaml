<UserControl x:Class="Pauth40.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pauth40.Localization"
             IsTabStop="True"
             UseSystemFocusVisuals="False">

    <Grid x:Name="Root"
          Background="Transparent"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased"
          KeyDown="Root_KeyDown">

        <Image x:Name="ScreenImage"
               Stretch="Uniform"
               IsHitTestVisible="False" />

        <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#A8020B16" />
            <Rectangle x:Name="DimBottom" Fill="#A8020B16" />
            <Rectangle x:Name="DimLeft" Fill="#A8020B16" />
            <Rectangle x:Name="DimRight" Fill="#A8020B16" />

            <Rectangle x:Name="SelectionFill"
                       Fill="#1400D9FF"
                       Visibility="Collapsed" />

            <Rectangle x:Name="SelectionBorder"
                       Stroke="#FF00D9FF"
                       StrokeThickness="1.6"
                       Visibility="Collapsed" />

            <Border x:Name="SizeChip"
                    Background="#F2071A2D"
                    BorderBrush="#CC00D9FF"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText"
                           Foreground="#F4F8FF"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Padding="20,10"
                CornerRadius="14"
                Background="#F2071A2D"
                BorderBrush="#9900D9FF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconCamera}"
                      Stroke="{StaticResource CyanBrush}"
                      StrokeThickness="1.7"
                      Width="21" Height="21"
                      VerticalAlignment="Center" />
                <TextBlock loc:Loc.Key="capture_hint"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock loc:Loc.Key="capture_cancel_hint"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,18,14"
                Padding="12,6"
                CornerRadius="9"
                Background="#D9071A2D"
                BorderBrush="#6600D9FF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock x:Name="VersionText"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11.5" />
        </Border>
    </Grid>
</UserControl>
