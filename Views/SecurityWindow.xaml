<Window x:Class="Pauth40.Views.SecurityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:Pauth40.Localization"
        Title="{loc:Loc security_title}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="570" Height="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#020B16"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" ClipToBounds="True" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ============================================================ TITLE BAR -->
        <Grid Grid.Row="0" Background="#06111F" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border VerticalAlignment="Bottom" Height="1" Background="#1B4164" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Path Data="{StaticResource IconShield}"
                      Style="{StaticResource LineIcon}"
                      Stroke="{StaticResource CyanBrush}"
                      StrokeThickness="1.7"
                      Width="21" Height="21" />
                <TextBlock x:Name="WindowTitleText"
                           Text="{loc:Loc security_title}"
                           Style="{StaticResource WindowTitleText}"
                           FontSize="15.5"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <ComboBox x:Name="LanguageCombo"
                          Width="188" Height="32"
                          Margin="0,0,8,0"
                          Style="{StaticResource LanguageComboBox}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="LanguageCombo_SelectionChanged"
                          AutomationProperties.Name="{loc:Loc common_language}" />
                <Button Style="{StaticResource CloseTitleBarButton}"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Loc common_close}" Click="Close_Click"
                        AutomationProperties.Name="{loc:Loc common_close}">
                    <Path Data="{StaticResource IconClose}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="13" Height="13" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================ CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="30,22,30,24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid>
                <!-- ==================================================== SETUP -->
                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc security_setup_heading}"
                               Style="{StaticResource SectionHeading}"
                               FontSize="27" />
                    <TextBlock Text="{loc:Loc security_setup_subtitle}"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               Margin="0,9,0,24" />

                    <TextBlock Text="{loc:Loc common_email}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SetupEmailBox"
                             Style="{StaticResource FieldTextBox}"
                             MaxLength="254"
                             LostFocus="SetupEmail_LostFocus"
                             AutomationProperties.Name="{loc:Loc common_email}" />

                    <TextBlock Text="{loc:Loc common_password}" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                    <PasswordBox x:Name="SetupPasswordBox"
                                 Style="{StaticResource FieldPasswordBox}"
                                 MaxLength="128"
                                 AutomationProperties.Name="{loc:Loc common_password}" />

                    <TextBlock Text="{loc:Loc common_confirm_password}" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
                    <PasswordBox x:Name="SetupConfirmBox"
                                 Style="{StaticResource FieldPasswordBox}"
                                 MaxLength="128"
                                 AutomationProperties.Name="{loc:Loc common_confirm_password}" />

                    <CheckBox x:Name="SetupSmtpCheckBox"
                              Style="{StaticResource FieldCheckBox}"
                              Content="{loc:Loc security_setup_smtp_check}"
                              Margin="0,20,0,0"
                              Checked="SetupSmtp_Checked"
                              Unchecked="SetupSmtp_Unchecked" />

                    <StackPanel x:Name="SetupSmtpPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc common_smtp_server}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SetupSmtpHostBox" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{loc:Loc common_port}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SetupSmtpPortBox" Style="{StaticResource FieldTextBox}" Text="587" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Loc common_smtp_user}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                        <TextBox x:Name="SetupSmtpUserBox" Style="{StaticResource FieldTextBox}" />

                        <TextBlock Text="{loc:Loc common_app_password}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                        <PasswordBox x:Name="SetupSmtpPasswordBox" Style="{StaticResource FieldPasswordBox}" MaxLength="128" />

                        <CheckBox x:Name="SetupSmtpSslCheckBox"
                                  Style="{StaticResource FieldCheckBox}"
                                  Content="{loc:Loc common_use_ssl_recommended}"
                                  IsChecked="True"
                                  Margin="0,14,0,0" />

                        <TextBlock Text="{loc:Loc security_setup_smtp_note}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="SetupErrorText"
                               Foreground="{StaticResource DangerBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="2,14,0,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="48"
                            Margin="0,20,0,0"
                            Click="Setup_Click"
                            AutomationProperties.Name="{loc:Loc security_setup_create}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconLock}"
                                  Style="{StaticResource LineIcon}"
                                  Stroke="#F7FDFF" StrokeThickness="1.8"
                                  Width="19" Height="19" />
                            <TextBlock Text="{loc:Loc security_setup_create}"
                                       Style="{StaticResource ButtonLabel}"
                                       FontSize="17"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ==================================================== UNLOCK -->
                <StackPanel x:Name="UnlockPanel" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc security_unlock_heading}"
                               Style="{StaticResource SectionHeading}"
                               FontSize="27" />
                    <TextBlock Text="{loc:Loc security_unlock_subtitle}"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               Margin="0,9,0,22" />

                    <Border Style="{StaticResource SectionCard}" Padding="16,13" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc security_unlock_email_label}" Style="{StaticResource FieldLabel}" Margin="2,0,0,5" />
                            <TextBlock x:Name="UnlockEmailText"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc common_password}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="UnlockPasswordBox"
                                 Style="{StaticResource FieldPasswordBox}"
                                 MaxLength="128"
                                 KeyDown="UnlockPassword_KeyDown"
                                 AutomationProperties.Name="{loc:Loc common_password}" />

                    <TextBlock x:Name="UnlockErrorText"
                               Foreground="{StaticResource DangerBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="2,14,0,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="48"
                            Margin="0,18,0,0"
                            IsDefault="True"
                            Click="Unlock_Click"
                            AutomationProperties.Name="{loc:Loc security_unlock_button}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconLock}"
                                  Style="{StaticResource LineIcon}"
                                  Stroke="#F7FDFF" StrokeThickness="1.8"
                                  Width="19" Height="19" />
                            <TextBlock Text="{loc:Loc security_unlock_button}"
                                       Style="{StaticResource ButtonLabel}"
                                       FontSize="17"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource LinkButton}"
                            Content="{loc:Loc security_unlock_forgot}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Click="Forgot_Click" />
                </StackPanel>

                <!-- ==================================================== RESET -->
                <StackPanel x:Name="ResetPanel" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc security_reset_heading}"
                               Style="{StaticResource SectionHeading}"
                               FontSize="27" />
                    <TextBlock x:Name="ResetSubtitleText"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               Margin="0,9,0,18" />

                    <StackPanel x:Name="ResetEmailArea">
                        <Button x:Name="SendCodeButton"
                                Style="{StaticResource SecondaryButton}"
                                Height="46"
                                Click="SendCode_Click"
                                AutomationProperties.Name="{loc:Loc security_reset_send_code}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconMail}"
                                      Style="{StaticResource LineIcon}"
                                      Stroke="{StaticResource CyanBrush}"
                                      StrokeThickness="1.6"
                                      Width="18" Height="18" />
                                <TextBlock Text="{loc:Loc security_reset_send_code}"
                                           Style="{StaticResource ButtonLabel}"
                                           FontSize="15"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="ResetStatusText"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Margin="2,10,0,0" />

                        <StackPanel x:Name="ResetSmtpPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <Border Style="{StaticResource SectionCard}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc security_reset_email_config}"
                                               Style="{StaticResource FieldLabel}"
                                               Foreground="{StaticResource CyanBrush}"
                                               Margin="0,0,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc common_smtp_server}" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ResetSmtpHostBox" Style="{StaticResource FieldTextBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{loc:Loc common_port}" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ResetSmtpPortBox" Style="{StaticResource FieldTextBox}" Text="587" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{loc:Loc common_smtp_user}" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                                    <TextBox x:Name="ResetSmtpUserBox" Style="{StaticResource FieldTextBox}" />

                                    <TextBlock Text="{loc:Loc common_app_password}" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                                    <PasswordBox x:Name="ResetSmtpPasswordBox" Style="{StaticResource FieldPasswordBox}" MaxLength="128" />

                                    <CheckBox x:Name="ResetSmtpSslCheckBox"
                                              Style="{StaticResource FieldCheckBox}"
                                              Content="{loc:Loc common_use_ssl}"
                                              IsChecked="True"
                                              Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc security_reset_code_label}" Style="{StaticResource FieldLabel}" Margin="2,18,0,6" />
                        <TextBox x:Name="ResetCodeBox"
                                 Style="{StaticResource FieldTextBox}"
                                 MaxLength="6"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="18"
                                 CharacterCasing="Upper" />
                    </StackPanel>

                    <StackPanel x:Name="ResetPasswordArea">
                        <TextBlock Text="{loc:Loc common_new_password}" Style="{StaticResource FieldLabel}" Margin="2,18,0,6" />
                        <PasswordBox x:Name="ResetPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128" />

                        <TextBlock Text="{loc:Loc common_confirm_new_password}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                        <PasswordBox x:Name="ResetConfirmBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128" />
                    </StackPanel>

                    <TextBlock x:Name="DpapiNoteText"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,14,0,0" />

                    <TextBlock x:Name="ResetErrorText"
                               Foreground="{StaticResource DangerBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="2,14,0,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="48"
                            Margin="0,18,0,0"
                            IsDefault="True"
                            Click="Reset_Click"
                            AutomationProperties.Name="{loc:Loc security_reset_button}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconKey}"
                                  Style="{StaticResource LineIcon}"
                                  Stroke="#F7FDFF" StrokeThickness="1.8"
                                  Width="19" Height="19" />
                            <TextBlock Text="{loc:Loc security_reset_button}"
                                       Style="{StaticResource ButtonLabel}"
                                       FontSize="17"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Vertical" Margin="0,14,0,0">
                        <Button x:Name="DpapiResetLink"
                                Style="{StaticResource LinkButton}"
                                Content="{loc:Loc security_reset_dpapi_link}"
                                HorizontalAlignment="Center"
                                Click="UseDpapi_Click" />
                        <Button Style="{StaticResource LinkButton}"
                                Content="{loc:Loc security_reset_back}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Click="BackToUnlock_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================ FOOTER -->
        <TextBlock x:Name="VersionText"
                   Grid.Row="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,18,6"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="11.5"
                   AutomationProperties.AutomationId="VersionText" />

        <!-- ============================================================ FRAME -->
        <Border Grid.RowSpan="3"
                CornerRadius="12"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5500D9FF" Offset="0" />
                    <GradientStop Color="#26007BFF" Offset="0.45" />
                    <GradientStop Color="#4D0050C8" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
    </Grid>
</Window>
