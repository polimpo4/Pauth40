<Window x:Class="Pauth40.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Pauth40 - Configurações"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="800" Height="820"
        MinWidth="640" MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#020B16"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" ClipToBounds="True" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ TITLE BAR -->
        <Grid Grid.Row="0" Background="#06111F" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border VerticalAlignment="Bottom" Height="1" Background="#1B4164" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Path Data="{StaticResource IconSettings}"
                      Style="{StaticResource LineIcon}"
                      Stroke="{StaticResource CyanBrush}"
                      StrokeThickness="1.7"
                      Width="21" Height="21" />
                <TextBlock Text="Configurações"
                           Style="{StaticResource WindowTitleText}"
                           FontSize="15.5"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Style="{StaticResource CloseTitleBarButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="Fechar" Click="Close_Click" AutomationProperties.Name="Fechar">
                <Path Data="{StaticResource IconClose}"
                      Stroke="{StaticResource TextSecondaryBrush}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="13" Height="13" Stretch="Uniform" />
            </Button>
        </Grid>

        <!-- ============================================================ CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="26,20,26,24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>

                <!-- ==================================================== ACCOUNT -->
                <TextBlock Text="Conta e segurança"
                           Style="{StaticResource SectionHeading}"
                           FontSize="22" />

                <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="E-MAIL DA CONTA" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="AccountEmailText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Height="1" Background="#1B4164" Margin="0,15,0,15" />

                        <TextBlock Text="ALTERAR SENHA"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{StaticResource CyanBrush}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="SENHA ATUAL" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128"
                                     AutomationProperties.Name="Senha atual" />

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="NOVA SENHA" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="NewPasswordBox"
                                             Style="{StaticResource FieldPasswordBox}"
                                             MaxLength="128"
                                             AutomationProperties.Name="Nova senha" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="CONFIRMAR NOVA SENHA" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Style="{StaticResource FieldPasswordBox}"
                                             MaxLength="128"
                                             AutomationProperties.Name="Confirmar nova senha" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="44"
                                    MinWidth="200"
                                    Padding="22,0"
                                    Click="ChangePassword_Click"
                                    AutomationProperties.Name="Alterar senha">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconKey}"
                                          Style="{StaticResource LineIcon}"
                                          Stroke="{StaticResource CyanBrush}"
                                          StrokeThickness="1.6"
                                          Width="17" Height="17" />
                                    <TextBlock Text="Alterar senha"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="14"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="PasswordStatusText"
                                       Grid.Column="1"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== E-MAIL -->
                <TextBlock Text="E-mail e recuperação de senha"
                           Style="{StaticResource SectionHeading}"
                           FontSize="22"
                           Margin="0,26,0,0" />

                <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="O código de recuperação de senha é enviado por este servidor. Em Gmail, Outlook e iCloud use uma senha de app."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SERVIDOR SMTP" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SmtpHostBox" Style="{StaticResource FieldTextBox}"
                                         AutomationProperties.Name="Servidor SMTP" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="PORTA" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SmtpPortBox" Style="{StaticResource FieldTextBox}" Text="587"
                                         AutomationProperties.Name="Porta SMTP" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="USUÁRIO SMTP" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SmtpUserBox" Style="{StaticResource FieldTextBox}"
                                         AutomationProperties.Name="Usuário SMTP" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="REMETENTE" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SmtpFromBox" Style="{StaticResource FieldTextBox}"
                                         AutomationProperties.Name="Remetente" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="SENHA DE APP" Style="{StaticResource FieldLabel}" Margin="2,13,0,6" />
                        <PasswordBox x:Name="SmtpPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128"
                                     AutomationProperties.Name="Senha de app" />

                        <CheckBox x:Name="SmtpSslCheckBox"
                                  Style="{StaticResource FieldCheckBox}"
                                  Content="Usar SSL/TLS (recomendado)"
                                  IsChecked="True"
                                  Margin="0,13,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="44"
                                    Padding="20,0"
                                    Click="SaveSmtp_Click"
                                    AutomationProperties.Name="Salvar e-mail">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheck}"
                                          Style="{StaticResource LineIcon}"
                                          Stroke="{StaticResource CyanBrush}"
                                          StrokeThickness="2"
                                          Width="17" Height="17" />
                                    <TextBlock Text="Salvar"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="14"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="TestSmtpButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="44"
                                    Padding="20,0"
                                    Margin="10,0,0,0"
                                    Click="TestSmtp_Click"
                                    AutomationProperties.Name="Enviar teste">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconMail}"
                                          Style="{StaticResource LineIcon}"
                                          Stroke="{StaticResource CyanBrush}"
                                          StrokeThickness="1.6"
                                          Width="17" Height="17" />
                                    <TextBlock Text="Enviar teste"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="14"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="SmtpStatusText"
                                       Grid.Column="2"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== DATABASE -->
                <TextBlock Text="Banco de dados"
                           Style="{StaticResource SectionHeading}"
                           FontSize="22"
                           Margin="0,26,0,0" />

                <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Exporte uma cópia criptografada das suas contas ou importe um backup feito pelo Pauth40. A importação mescla as contas sem duplicar segredos."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="SENHA DO BACKUP" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="BackupPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     MaxLength="128"
                                     AutomationProperties.Name="Senha do backup" />

                        <TextBlock Text="Use uma senha com pelo menos 8 caracteres. Ela será pedida em qualquer importação futura."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="46"
                                    Margin="0,0,6,0"
                                    Click="Export_Click"
                                    AutomationProperties.Name="Exportar banco de dados">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconExport}"
                                          Style="{StaticResource LineIcon}"
                                          Stroke="{StaticResource CyanBrush}"
                                          StrokeThickness="1.7"
                                          Width="18" Height="18" />
                                    <TextBlock Text="Exportar"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="15"
                                               Margin="9,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="46"
                                    Margin="6,0,0,0"
                                    Click="Import_Click"
                                    AutomationProperties.Name="Importar banco de dados">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconImport}"
                                          Style="{StaticResource LineIcon}"
                                          Stroke="{StaticResource CyanBrush}"
                                          StrokeThickness="1.7"
                                          Width="18" Height="18" />
                                    <TextBlock Text="Importar"
                                               Style="{StaticResource ButtonLabel}"
                                               FontSize="15"
                                               Margin="9,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="BackupStatusText"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Margin="2,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ FRAME -->
        <Border Grid.RowSpan="2"
                CornerRadius="12"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5500D9FF" Offset="0" />
                    <GradientStop Color="#26007BFF" Offset="0.45" />
                    <GradientStop Color="#4D0050C8" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
    </Grid>
</Window>
