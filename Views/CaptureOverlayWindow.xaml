<Window x:Class="Pauth40.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pauth40.Localization"
        Title="{loc:Loc capture_title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">
    <Grid x:Name="Root" Background="Transparent"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Image x:Name="ScreenImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False" />

        <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#A8020B16" />
            <Rectangle x:Name="DimBottom" Fill="#A8020B16" />
            <Rectangle x:Name="DimLeft" Fill="#A8020B16" />
            <Rectangle x:Name="DimRight" Fill="#A8020B16" />

            <Rectangle x:Name="SelectionFill" Fill="#1400D9FF" Visibility="Collapsed" />
            <Rectangle x:Name="SelectionBorder" Stroke="#FF00D9FF" StrokeThickness="1.6"
                       Visibility="Collapsed">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#00D9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
                </Rectangle.Effect>
            </Rectangle>

            <Border x:Name="SizeChip"
                    Background="#F2071A2D"
                    BorderBrush="#CC00D9FF"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText"
                           Foreground="#F4F8FF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,28,0,0"
                Padding="22,12"
                CornerRadius="14"
                Background="#F2071A2D"
                BorderBrush="#9900D9FF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000814" BlurRadius="26" ShadowDepth="8" Opacity="0.6" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconCamera}"
                      Style="{StaticResource LineIcon}"
                      Stroke="{StaticResource CyanBrush}"
                      StrokeThickness="1.7"
                      Width="21" Height="21"
                      VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc capture_hint}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc capture_cancel_hint}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,18,18"
                Padding="12,6"
                CornerRadius="9"
                Background="#D9071A2D"
                BorderBrush="#6600D9FF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock x:Name="VersionText"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="11.5"
                       AutomationProperties.AutomationId="VersionText" />
        </Border>
    </Grid>
</Window>
