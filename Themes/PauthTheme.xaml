<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Pauth40.Converters">

    <!-- ============================================================ Palette -->
    <Color x:Key="BgDeepColor">#020B16</Color>
    <Color x:Key="BgSecondaryColor">#061426</Color>
    <Color x:Key="SurfaceColor">#0A1C31</Color>
    <Color x:Key="GlassColor">#102A45</Color>
    <Color x:Key="CyanColor">#00D9FF</Color>
    <Color x:Key="BlueColor">#007BFF</Color>
    <Color x:Key="DeepBlueColor">#0050C8</Color>
    <Color x:Key="BorderBlueColor">#174A70</Color>
    <Color x:Key="TextPrimaryColor">#F4F8FF</Color>
    <Color x:Key="TextSecondaryColor">#9CB8D3</Color>
    <Color x:Key="TextMutedColor">#6F94B8</Color>
    <Color x:Key="BeakColor">#FFB52E</Color>
    <Color x:Key="DangerColor">#FF5C70</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="DeepBlueBrush" Color="{StaticResource DeepBlueColor}" />
    <SolidColorBrush x:Key="BorderBlueBrush" Color="{StaticResource BorderBlueColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BeakBrush" Color="{StaticResource BeakColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="#02101F" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- ============================================================ Gradients -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#07182B" Offset="0" />
        <GradientStop Color="#04101F" Offset="0.42" />
        <GradientStop Color="#01060D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0C2942" Offset="0" />
        <GradientStop Color="#0A2036" Offset="0.45" />
        <GradientStop Color="#061525" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PanelSoftBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A2338" Offset="0" />
        <GradientStop Color="#061627" Offset="0.55" />
        <GradientStop Color="#030C17" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CodePanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A2942" Offset="0" />
        <GradientStop Color="#071B2E" Offset="0.55" />
        <GradientStop Color="#020C17" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SelectorBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B253C" Offset="0" />
        <GradientStop Color="#071829" Offset="0.6" />
        <GradientStop Color="#040F1B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A800D9FF" Offset="0" />
        <GradientStop Color="#5500D9FF" Offset="0.45" />
        <GradientStop Color="#40007BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanBlueBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00D9FF" Offset="0" />
        <GradientStop Color="#00A8FF" Offset="0.5" />
        <GradientStop Color="#007BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanBlueHorizontalBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D9FF" Offset="0" />
        <GradientStop Color="#007BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22E2FF" Offset="0" />
        <GradientStop Color="#00B7F2" Offset="0.45" />
        <GradientStop Color="#007BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6BEFFF" Offset="0" />
        <GradientStop Color="#25C8FF" Offset="0.45" />
        <GradientStop Color="#1A8FFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SecondaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A2136" Offset="0" />
        <GradientStop Color="#061626" Offset="0.6" />
        <GradientStop Color="#030C16" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SecondaryButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F2E49" Offset="0" />
        <GradientStop Color="#081E33" Offset="0.6" />
        <GradientStop Color="#04101D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FooterLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0000D9FF" Offset="0" />
        <GradientStop Color="#6600D9FF" Offset="0.5" />
        <GradientStop Color="#0000D9FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TextAccentBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F4F8FF" Offset="0" />
        <GradientStop Color="#B9F5FF" Offset="0.55" />
        <GradientStop Color="#00D9FF" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================ Effects -->
    <DropShadowEffect x:Key="CyanGlow" x:Shared="False" Color="#00D9FF" BlurRadius="30" ShadowDepth="0" Opacity="0.42" />
    <DropShadowEffect x:Key="CyanGlowSoft" x:Shared="False" Color="#00D9FF" BlurRadius="20" ShadowDepth="0" Opacity="0.24" />
    <DropShadowEffect x:Key="BlueGlow" x:Shared="False" Color="#007BFF" BlurRadius="34" ShadowDepth="0" Opacity="0.38" />
    <DropShadowEffect x:Key="PanelShadow" x:Shared="False" Color="#000814" BlurRadius="34" ShadowDepth="12" Opacity="0.55" />
    <DropShadowEffect x:Key="TextGlow" x:Shared="False" Color="#00D9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.35" />

    <!-- ============================================================ Geometries -->
    <Geometry x:Key="IconMinimize">M 4,12 H 20</Geometry>
    <Geometry x:Key="IconMaximize">M 5.5,5.5 H 18.5 V 18.5 H 5.5 Z</Geometry>
    <Geometry x:Key="IconRestore">M 8.5,8.5 H 19 V 19 H 8.5 Z M 5,16 V 5 H 16</Geometry>
    <Geometry x:Key="IconClose">M 5.5,5.5 L 18.5,18.5 M 18.5,5.5 L 5.5,18.5</Geometry>
    <Geometry x:Key="IconChevron">M 5.5,9 L 12,15.5 L 18.5,9</Geometry>
    <Geometry x:Key="IconShield">M 12,2.4 L 20,5.7 V 11.4 C 20,16.8 16.5,20.5 12,21.6 C 7.5,20.5 4,16.8 4,11.4 V 5.7 Z M 8.4,11.7 L 10.9,14.3 L 15.9,9.1</Geometry>
    <Geometry x:Key="IconCamera">M 4,7.5 H 8.2 L 9.6,4.8 H 14.4 L 15.8,7.5 H 20 V 19.5 H 4 Z M 12,16.6 A 3.5,3.5 0 1 0 12,9.6 A 3.5,3.5 0 1 0 12,16.6 Z</Geometry>
    <Geometry x:Key="IconCopy">M 8.5,8.5 H 19 V 21 H 8.5 Z M 5.5,16 H 5 V 3 H 15.5 V 8</Geometry>
    <Geometry x:Key="IconCheck">M 4,12.6 L 9.4,18 L 20,6.4</Geometry>
    <Geometry x:Key="IconTrash">M 4,6.2 H 20 M 9,6.2 V 3.6 H 15 V 6.2 M 6.2,6.2 L 7.2,21 H 16.8 L 17.8,6.2 M 10,10 V 17.4 M 14,10 V 17.4</Geometry>
    <Geometry x:Key="IconRefresh">M 20,12 A 8,8 0 1 1 17.3,6.1 M 20,3.2 V 8.2 H 15</Geometry>
    <Geometry x:Key="IconDatabase">M 4,6 C 4,4.3 7.6,3 12,3 C 16.4,3 20,4.3 20,6 C 20,7.7 16.4,9 12,9 C 7.6,9 4,7.7 4,6 Z M 4,6 V 12 C 4,13.7 7.6,15 12,15 C 16.4,15 20,13.7 20,12 V 6 M 4,12 V 18 C 4,19.7 7.6,21 12,21 C 16.4,21 20,19.7 20,18 V 12</Geometry>
    <Geometry x:Key="IconLock">M 6,10.5 H 18 V 21 H 6 Z M 8.5,10.5 V 7.5 A 3.5,3.5 0 0 1 15.5,7.5 V 10.5</Geometry>
    <Geometry x:Key="IconSettings">M 3,7 H 5.8 M 10.2,7 H 21 M 8,4.8 A 2.2,2.2 0 1 0 8,9.2 A 2.2,2.2 0 1 0 8,4.8 Z M 3,12 H 11.8 M 16.2,12 H 21 M 14,9.8 A 2.2,2.2 0 1 0 14,14.2 A 2.2,2.2 0 1 0 14,9.8 Z M 3,17 H 7.8 M 12.2,17 H 21 M 10,14.8 A 2.2,2.2 0 1 0 10,19.2 A 2.2,2.2 0 1 0 10,14.8 Z</Geometry>
    <Geometry x:Key="IconMail">M 3,6 H 21 V 18 H 3 Z M 3.5,6.6 L 12,13 L 20.5,6.6</Geometry>
    <Geometry x:Key="IconExport">M 12,3 V 15 M 7.5,10.5 L 12,15 L 16.5,10.5 M 4,17.5 V 20.5 H 20 V 17.5</Geometry>
    <Geometry x:Key="IconImport">M 12,15 V 3 M 7.5,7.5 L 12,3 L 16.5,7.5 M 4,17.5 V 20.5 H 20 V 17.5</Geometry>
    <Geometry x:Key="IconKey">M 9.5,14.5 A 4.5,4.5 0 1 0 9.5,5.5 A 4.5,4.5 0 1 0 9.5,14.5 Z M 12.7,11.7 L 20,19 M 17,16 L 19.5,13.5 M 14.5,13.5 L 17,11</Geometry>

    <!-- ============================================================ Converters -->
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />

    <!-- ============================================================ Text styles -->
    <Style x:Key="WindowTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="TrackingLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="SubHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="70" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="ButtonLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ============================================================ Icon styles -->
    <Style x:Key="LineIcon" TargetType="Path">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================================================ Title-bar buttons -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="9" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1A00D9FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#3300D9FF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="9" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#E81123" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#B20D1B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Primary button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="58" />
        <Setter Property="Foreground" Value="#F7FDFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Shadow" CornerRadius="15,15,17,17" Background="#26000000" Margin="0,5,0,-5" />
                        <Border x:Name="Bg" CornerRadius="15" BorderThickness="1"
                                BorderBrush="#B8B9FAFF" Background="{StaticResource PrimaryButtonBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D9FF" BlurRadius="26" ShadowDepth="0" Opacity="0.45" />
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="14" Margin="1" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#55FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#F0F3FEFF" />
                            <Setter TargetName="Bg" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00D9FF" BlurRadius="36" ShadowDepth="0" Opacity="0.78" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1.5" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bg" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00D9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.3" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#8000D9FF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="#0A2237" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#3000D9FF" />
                            <Setter TargetName="Bg" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Secondary button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="58" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Shadow" CornerRadius="15,15,17,17" Background="#20000000" Margin="0,4,0,-4" />
                        <Border x:Name="Bg" CornerRadius="15" BorderThickness="1"
                                BorderBrush="{StaticResource GlassBorderBrush}" Background="{StaticResource SecondaryButtonBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#007BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.18" />
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="14" Margin="1" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#24FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#D000D9FF" />
                            <Setter TargetName="Bg" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#007BFF" BlurRadius="26" ShadowDepth="0" Opacity="0.44" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1.5" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bg" Property="Background" Value="#04101C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Progress bar -->
    <Style x:Key="CountdownProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource CyanBlueHorizontalBrush}" />
        <Setter Property="Background" Value="#12314D" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Account combo -->
    <Style x:Key="AccountComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Margin="6,2" Padding="10,0" CornerRadius="12" Background="Transparent">
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center"
                                    Background="{StaticResource CyanBlueBrush}">
                                <TextBlock Text="{Binding Initial}" Foreground="{StaticResource InkBrush}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,20,0">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMutedBrush}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#1A00D9FF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#2600D9FF" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="#3300D9FF" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MiniIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2EFF5C70" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#48FF5C70" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Form controls -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="2,0,0,6" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="SelectionBrush" Value="#9000D9FF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="FieldBorder" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{StaticResource GlassBorderBrush}" Background="#081A2D">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#8A00D9FF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#E000D9FF" />
                            <Setter TargetName="FieldBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00D9FF" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="SelectionBrush" Value="#9000D9FF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="FieldBorder" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{StaticResource GlassBorderBrush}" Background="#081A2D">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#8A00D9FF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#E000D9FF" />
                            <Setter TargetName="FieldBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00D9FF" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{StaticResource GlassBorderBrush}" Background="#081A2D"
                                VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="{StaticResource IconCheck}"
                                  Stroke="{StaticResource CyanBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="11" Height="11" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#B000D9FF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#D000D9FF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#9DF1FF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background" Value="#081A2D" />
        <Setter Property="BorderBrush" Value="#1B4164" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ============================================================ Scrollbars -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBody"
                            CornerRadius="4"
                            Background="#2B5A7E"
                            Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="#4685B0" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="#00D9FF" />
                            <Setter TargetName="ThumbBody" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00D9FF" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppScrollBar" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                              Command="{x:Static ScrollBar.PageUpCommand}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                              Command="{x:Static ScrollBar.PageDownCommand}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBar}" />

    <Style x:Key="AccountComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="62" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsEditable" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AccountComboBoxItem}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box" CornerRadius="15" BorderThickness="1"
                                            BorderBrush="{StaticResource GlassBorderBrush}" Background="{StaticResource SelectorBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#007BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.15" />
                                        </Border.Effect>
                                        <Grid Margin="15,0,16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center"
                                                    Background="{StaticResource CyanBlueBrush}">
                                                <TextBlock Text="{Binding SelectedAccountInitial}"
                                                           Foreground="{StaticResource InkBrush}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="15" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding SelectedAccountName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="16.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SelectedAccountSubtitle}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11.5" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="RemoveButton" Width="30" Height="30" Margin="0,0,6,0"
                                                        Style="{StaticResource MiniIconButton}"
                                                        Command="{Binding RemoveAccountCommand}"
                                                        ToolTip="Remove the selected account (click twice to confirm)"
                                                        Focusable="False"
                                                        Opacity="1" IsHitTestVisible="True"
                                                        Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibility}}">
                                                    <Path Data="{StaticResource IconTrash}"
                                                          Stroke="{StaticResource TextMutedBrush}"
                                                          Style="{StaticResource LineIcon}"
                                                          Width="15" Height="15" StrokeThickness="1.5" />
                                                </Button>
                                                <Path Data="{StaticResource IconChevron}"
                                                      Stroke="{StaticResource TextMutedBrush}" Style="{StaticResource LineIcon}"
                                                      Width="14" Height="14" StrokeThickness="1.8" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#D000D9FF" />
                                            <Setter TargetName="Box" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#007BFF" BlurRadius="24" ShadowDepth="0" Opacity="0.42" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                                            <Setter TargetName="RemoveButton" Property="IsHitTestVisible" Value="True" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#F000D9FF" />
                                            <Setter TargetName="Box" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#00D9FF" BlurRadius="26" ShadowDepth="0" Opacity="0.55" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Slide" VerticalOffset="6">
                            <Border Width="{TemplateBinding ActualWidth}" MaxHeight="390"
                                    Background="#FA071A2D" BorderBrush="#8000D9FF" BorderThickness="1"
                                    CornerRadius="16" Padding="0,8,0,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000914" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                                </Border.Effect>
                                <Grid>
                                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                    <StackPanel Margin="0,22,0,22" IsHitTestVisible="False"
                                                Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="No accounts yet" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Use Capture Screen to scan your first QR code."
                                                   HorizontalAlignment="Center" Margin="0,5,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
